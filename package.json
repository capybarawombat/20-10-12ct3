{
  "name": "the-blooming-wishes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node --experimental-strip-types tests/progress.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "qr": "python3 scripts/generate_qr.py"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "@playwright/test": "1.64.1"
  }
}
